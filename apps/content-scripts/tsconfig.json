{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@content/*": ["./src/*"]
    },
    "strict": true,
    "target": "ES2022",
    "types": ["chrome"]
  },
  "include": ["src/**/*.ts"]
}
